# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: MongoDB connection string (e.g., mongodb://localhost:27017/dayflow_hrms or Atlas URI)
# In standalone mode or preview, Dayflow includes an in-memory embedded engine fallback with auto-seeding.
MONGODB_URI="mongodb://localhost:27017/dayflow_hrms"

# JWT_SECRET: Secret key for signing authentication tokens
JWT_SECRET="dayflow_jwt_secret_hrms_secure_token"

